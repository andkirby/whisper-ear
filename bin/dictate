#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WHISPER_EAR_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

PATH="$HOME/miniforge3/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
export PATH
export PYTHONPATH="$WHISPER_EAR_DIR${PYTHONPATH:+:$PYTHONPATH}"

find_python() {
    local candidate
    for candidate in \
        "$WHISPER_EAR_DIR/.venv/bin/python3" \
        "$HOME/miniforge3/bin/python3" \
        "/opt/homebrew/bin/python3" \
        "/usr/local/bin/python3" \
        "python3"
    do
        if command -v "$candidate" >/dev/null 2>&1 &&
           "$candidate" -c 'import faster_whisper' >/dev/null 2>&1; then
            echo "$candidate"
            return 0
        fi
    done
    return 1
}

PYTHON3="$(find_python)" || {
    echo "No Python with faster-whisper found" >&2
    exit 1
}

exec "$PYTHON3" -m whisper_ear.dictate_cli "$@"
