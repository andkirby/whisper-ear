#!/usr/bin/env bash
#
# f-whisper - Faster transcription using faster-whisper
#
# Usage: f-whisper <audio_file> [options]
#

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TRANSCRIBE_SCRIPT="$SCRIPT_DIR/../transcribe.py"

# Check if transcribe.py exists
if [ ! -f "$TRANSCRIBE_SCRIPT" ]; then
    echo "Error: transcribe.py not found at $TRANSCRIBE_SCRIPT"
    exit 1
fi

# Find the Python that has faster-whisper installed
# Check miniforge first (where we know it's installed)
PYTHON3=""
for cmd in "$HOME/miniforge3/bin/python3" "/opt/homebrew/bin/python3" "/usr/local/bin/python3" "python3"; do
    if [ -f "$cmd" ] && "$cmd" -c "import faster_whisper" 2>/dev/null; then
        PYTHON3="$cmd"
        break
    fi
done

if [ -z "$PYTHON3" ]; then
    echo "Error: No python3 with faster-whisper found"
    echo "Install with: pip install faster-whisper"
    exit 1
fi

# Run transcribe.py with all arguments
"$PYTHON3" "$TRANSCRIBE_SCRIPT" "$@"
